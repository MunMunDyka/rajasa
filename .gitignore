# Dependencies
node_modules/

# Next.js build output
.next/
out/
next-env.d.ts

# Environment — never commit. .env holds the Supabase password and AUTH_SECRET.
.env
.env.*
!.env.example

# Uploaded files. Client documents belong on the server, not in git.
#
# The leading slash matters. Without it, "storage/" matches a directory of that
# name at ANY depth - which silently swallowed frontend/src/server/storage/,
# the file-storage service itself, and the omission only surfaced as a build
# failure on a machine that had not seen the file before.
/storage/
/frontend/storage/

# Logs and caches
*.log
npm-debug.log*
.turbo/
*.tsbuildinfo

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# AI agent instruction files, auto-generated by tooling
CLAUDE.md
AGENTS.md
