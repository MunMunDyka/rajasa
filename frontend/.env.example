# =============================================================================
# RKL ProjectHub - environment template
#
# Copy this file to .env and fill in the values.  .env is gitignored and must
# never be committed. See ../README.md for the full phase A / phase B context.
#
#   cp .env.example .env
# =============================================================================


# -----------------------------------------------------------------------------
# DATABASE  (Phase A = Supabase)
# -----------------------------------------------------------------------------
# Where to find these two strings:
#
#   1. supabase.com -> your project
#   2. Click "Connect" in the top bar
#   3. Open the "ORMs" tab, choose "Prisma"
#   4. Supabase prints exactly these two variables - copy them here
#
# Why two? Prisma needs both:
#   DATABASE_URL  port 6543, the transaction pooler. Used by the running app.
#                 Must keep ?pgbouncer=true or prepared statements break.
#   DIRECT_URL    port 5432, a direct connection. Used by `prisma migrate` only,
#                 because migrations cannot run through a pooler.
#
# [YOUR-PASSWORD] is the database password you set when creating the project.
# Forgot it? Supabase dashboard -> Settings -> Database -> Reset database password.
# If the password contains @ : / ? # or %, URL-encode it (@ becomes %40).
#
# Pick the Southeast Asia (Singapore) region - closest to Jakarta.
#
# At go-live both of these point at the local Postgres on the VPS instead.
# See "Go-Live Migration" in ../README.md.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"


# -----------------------------------------------------------------------------
# AUTH  (Auth.js v5)
# -----------------------------------------------------------------------------
# Generate a fresh secret with:
#
#   npx auth secret
#
# or:  openssl rand -base64 32
#
# MUST be regenerated at go-live. Never ship the demo secret to production.

AUTH_SECRET=""

# Base URL of the app. Becomes the real https domain at go-live.
AUTH_URL="http://localhost:3000"


# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# Root directory for uploaded documents and progress evidence.
# Files are NOT stored in Supabase - see decision D9 in the planning doc.
#
# Phase A (local):  ./storage/uploads
# Phase B (VPS):    /srv/rkl/uploads   <- outside the code dir, so a deploy
#                                         can never overwrite client files.

UPLOAD_ROOT="./storage/uploads"

# Reject uploads larger than this (bytes). 20 MB default.
MAX_UPLOAD_BYTES="20971520"


# -----------------------------------------------------------------------------
# DEMO MODE
# -----------------------------------------------------------------------------
# true  -> topbar role switcher is shown, so a demo can jump between CEO /
#          Engineer / Accountant without logging out (decision D6).
#          It can only switch into seeded users flagged isDemo = true.
# false -> switcher is removed entirely. REQUIRED at go-live.

DEMO_MODE="true"


# -----------------------------------------------------------------------------
# BRANDING
# -----------------------------------------------------------------------------
# App name is configurable per section 2 of the planning doc.

NEXT_PUBLIC_APP_NAME="RKL ProjectHub"
